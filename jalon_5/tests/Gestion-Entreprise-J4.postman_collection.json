    {
      "key": "employe",
      "value": "http://localhost:8080/employe-service"
    },
    {
      "key": "mission",
      "value": "http://localhost:8080/mission-service"
    },
    {
      "key": "config",
      "value": "http://localhost:8888"
    },
    {
      "key": "execution",
      "value": ""
    },
    {
      "key": "missionId",
      "value": ""
    },
    {
      "key": "departementId",
      "value": ""
    },
    {
      "key": "employeId",
      "value": ""
    },
    {
      "key": "missionDiffereeId",
      "value": ""
