        {
          "name": "Configuration agrégée depuis Git",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{config}}/mission-service/default/main"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"name\", () => pm.expect(body[\"name\"]).to.eql(\"mission-service\"));",
                  "pm.test(\"label\", () => pm.expect(body[\"label\"]).to.eql(\"main\"));",
                  "pm.test(\"propertySources.0.source.server.port\", () => pm.expect(body[\"propertySources\"][\"0\"][\"source\"][\"server.port\"]).to.eql(\"8083\"));",
                  "pm.test(\"propertySources.1.source.info.projet\", () => pm.expect(body[\"propertySources\"][\"1\"][\"source\"][\"info.projet\"]).to.eql(\"Gestion d'entreprise\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
