                  "pm.test(\"statut\", () => pm.expect(body[\"statut\"]).to.eql(\"VALIDEE\"));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"missionId\", String(body.id));",
                  "pm.test(\"Indicateur de rejeu\", () => pm.expect(pm.response.headers.get(\"Idempotency-Replayed\")).to.eql(\"false\"));"
                ]
              }
            }
          ],
          "response": []
