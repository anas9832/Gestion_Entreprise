                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"RESSOURCE_INTROUVABLE\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Email invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{employe}}/employes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Karim de la démo\",\n  \"email\": \"invalide\",\n  \"departementId\": 1,\n  \"actif\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"VALIDATION\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Mission créée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mission}}/missions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeId\": 1,\n  \"departementId\": 1,\n  \"objet\": \"Audit réseau {{execution}}\",\n  \"dureeJours\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"statut\", () => pm.expect(body[\"statut\"]).to.eql(\"VALIDEE\"));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"missionId\", String(body.id));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Mission locale",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mission}}/missions/{{missionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"id\", () => pm.expect(body[\"id\"]).to.eql(Number(pm.collectionVariables.get(\"missionId\"))));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Mission absente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mission}}/missions/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"RESSOURCE_INTROUVABLE\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Durée invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mission}}/missions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeId\": 1,\n  \"departementId\": 1,\n  \"objet\": \"Trop longue\",\n  \"dureeJours\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"VALIDATION\"));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
