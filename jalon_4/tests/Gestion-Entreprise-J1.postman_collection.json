{
  "info": {
    "name": "Gestion d’entreprise — Jalon 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exécuter le dossier 01 sur les applications démarrées. Les dossiers suivants sont des scénarios manuels."
  },
  "variable": [
    {
      "key": "departement",
      "value": "http://localhost:8081"
    },
    {
      "key": "employe",
      "value": "http://localhost:8082"
    },
    {
      "key": "mission",
      "value": "http://localhost:8083"
    },
    {
      "key": "execution",
      "value": ""
    },
    {
      "key": "missionId",
      "value": ""
    },
    {
      "key": "departementId",
      "value": ""
    },
    {
      "key": "employeId",
      "value": ""
    },
    {
      "key": "missionDiffereeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Parcours normal et erreurs",
      "item": [
        {
          "name": "Département initial",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{departement}}/departements/1"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"execution\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"id\", () => pm.expect(body[\"id\"]).to.eql(1));",
                  "pm.test(\"actif\", () => pm.expect(body[\"actif\"]).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Département créé",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{departement}}/departements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Direction-{{execution}}\",\n  \"actif\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"actif\", () => pm.expect(body[\"actif\"]).to.eql(true));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"departementId\", String(body.id));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Département absent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{departement}}/departements/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"RESSOURCE_INTROUVABLE\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Département invalide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{departement}}/departements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"\",\n  \"actif\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(body[\"code\"]).to.eql(\"VALIDATION\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Employé créé",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{employe}}/employes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Karim de la démo\",\n  \"email\": \"karim-{{execution}}@example.test\",\n  \"departementId\": 1,\n  \"actif\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"actif\", () => pm.expect(body[\"actif\"]).to.eql(true));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"employeId\", String(body.id));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Employé absent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{employe}}/employes/999999"
          },
          "event": [
            {
              "listen": "test",
